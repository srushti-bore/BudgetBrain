# BudgetBrain Frontend Environment Variables Example
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local or sensitive secrets to version control.

# ─── API Base URL ──────────────────────────────────────────────────────────
# Local FastAPI backend:  http://localhost:8000/api/v1
# Production Render URL:  https://budgetbrain-ojnr.onrender.com/api/v1
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# ─── Google OAuth 2.0 Client ID (Optional for Google Sign-In) ──────────────
# Obtain from Google Cloud Console (APIs & Services > Credentials > OAuth 2.0 Client IDs)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
