# BudgetBrain Frontend Environment Variables Example
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local or sensitive secrets to version control.

# ─── API Base URL ──────────────────────────────────────────────────────────
# Local FastAPI backend:  http://localhost:8000/api/v1
# Production Render URL:  https://budgetbrain-ojnr.onrender.com/api/v1
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# ─── Google OAuth 2.0 Client ID (For Google Sign-In) ──────────────────────
# Obtain from Google Cloud Console (APIs & Services > Credentials > OAuth 2.0 Client IDs)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ─── AI Intelligence Configuration Notice ──────────────────────────────────
# NOTE ON AI KEYS:
# For maximum security, all AI keys (GEMINI_API_KEY, OPENAI_API_KEY, ANTHROPIC_API_KEY)
# and AI_PROVIDER configs are managed EXCLUSIVELY on the backend server (backend/.env or Render).
# This prevents your private API keys from ever being exposed to client browsers or network inspection.
#
# The frontend seamlessly accesses AI recommendations via:
#   GET  /api/v1/ai/insights
#   POST /api/v1/ai/suggest-category
#   GET  /api/v1/ai/suggest-budget
