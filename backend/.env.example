# BudgetBrain Backend — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ─── Database ──────────────────────────────────────────────────────────────
# Async PostgreSQL connection string
# Local:  postgresql+asyncpg://user:password@localhost:5432/budgetbrain
# Supabase: postgresql+asyncpg://postgres:<password>@<host>:5432/postgres
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/budgetbrain

# ─── App ────────────────────────────────────────────────────────────────────
APP_ENV=development
APP_DEBUG=true

# ─── CORS ───────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000

# ─── Budget Thresholds ──────────────────────────────────────────────────────
# Percentage at which budget status changes from "on_track" to "near_limit"
BUDGET_NEAR_LIMIT_THRESHOLD=80

# ─── Pagination ─────────────────────────────────────────────────────────────
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
