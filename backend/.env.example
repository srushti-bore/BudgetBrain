# BudgetBrain Backend — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ─── Database ──────────────────────────────────────────────────────────────
# Async PostgreSQL connection string
# Local:  postgresql+asyncpg://user:password@localhost:5432/budgetbrain
# Supabase: postgresql+asyncpg://postgres:<password>@<host>:5432/postgres
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/budgetbrain

# ─── App ────────────────────────────────────────────────────────────────────
APP_ENV=development
APP_DEBUG=true

# ─── CORS ───────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://budget-brain-eight.vercel.app

# ─── Authentication & Security ─────────────────────────────────────────────
# Secret key used for signing JWT Access Tokens (Generate with: openssl rand -hex 32)
JWT_SECRET_KEY=change-this-to-a-super-secret-hex-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Google OAuth 2.0 / OpenID Connect (Obtain from Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Cookie Security (Set COOKIE_SECURE=true in production with HTTPS)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# ─── Budget Thresholds ──────────────────────────────────────────────────────
# Percentage at which budget status changes from "on_track" to "near_limit"
BUDGET_NEAR_LIMIT_THRESHOLD=80

# ─── SMTP Email Service (For OTP & Verification Emails) ────────────────────
# Option A — Resend (Recommended for Production):
# 1. Create free account at https://resend.com
# 2. Generate API Key at https://resend.com/api-keys
# 3. Use smtp.resend.com, user 'resend', and your API key as password.
# 4. If using Resend test domain, use onboarding@resend.dev as FROM_EMAIL.
#    Once you verify your domain, use noreply@yourdomain.com
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=re_123456789_your_resend_api_key
SMTP_FROM_EMAIL=onboarding@resend.dev
SMTP_FROM_NAME="BudgetBrain Security"
SMTP_TLS=true
FRONTEND_URL=https://budget-brain-eight.vercel.app

# Option B — Gmail (For testing/personal):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-16-digit-gmail-app-password
# SMTP_FROM_EMAIL=your-email@gmail.com
# SMTP_FROM_NAME="BudgetBrain Security"
# SMTP_TLS=true

# ─── Pagination ─────────────────────────────────────────────────────────────
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# ─── AI Financial Intelligence Engine (Provider-Independent) ───────────────
# Choose your active AI provider: 'gemini', 'openai', 'anthropic', or 'rules'
# If no provider API key is set, BudgetBrain automatically uses its intelligent zero-cost rules fallback.
AI_PROVIDER=gemini
AI_MODEL=
AI_TEMPERATURE=0.3

# Google Gemini (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# OpenAI (https://platform.openai.com/api-keys) or compatible (e.g. Ollama, Groq, DeepSeek)
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Anthropic Claude (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=


