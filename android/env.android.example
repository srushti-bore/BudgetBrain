# BudgetBrain Android Environment Variables Template
# Set these in your system environment or CI/CD secrets (e.g., GitHub Actions Secrets)

# Backend API Base URL
BUDGETBRAIN_API_BASE_URL=https://budgetbrain-ojnr.onrender.com/api/v1/

# Google OAuth Web Client ID for Credential Manager Sign-In
GOOGLE_WEB_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Feature Toggles
ENABLE_BIOMETRIC_LOCK=true
